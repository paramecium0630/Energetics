&network
    ! N and directed are overridden by FCNN/EXTERNAL where applicable.
    N          = 70
    directed   = .false.
    graph_type = "EXTERNAL"
    p          = 0.2
    network_file = "input/mnistx2/weighted_matrix.dat"
/

&dynamics
    bias_file   = "input/mnistx2/bias.dat"
    bias_mode   = "AUTO"
    bias_mean   = 0.0
    bias_std    = 2.0
    r_mean     = 5.0
    r_std      = 0.1
    weight_mean = 0.0
    weight_std  = 0.2
    coupling_type = "TANH"
    sigma_mean = 0.1
/

&theory
    verify_lyapunov = .true.
    n_weight_shuffles = 0
    shuffle_seed      = 1001
/

&simulation
    run_simulation = .false.
    dt       = 0.0005
    t_relax  = 10.0
    t_sample = 5000.0
    lag_steps = 1
    seed     = 1
/
