&network
    ! N, directed : not for FCNN
    N          = 10
    directed   = .false.
    graph_type = "FCNN"    
    p          = 0.5
/

&dynamics
    r_mean     = 1.0
    r_std      = 0.1
    weight_mean = 1
    weight_std  = 0.1
/

&noise
    sigma_mean = 0.01
/

&simulation
    run_simulation = .false.
    dt       = 0.0005
    t_relax  = 100.0
    t_sample = 10000.0
    lag_steps = 1
    seed     = 1
/