&network
    ! N, directed : not for FCNN
    N          = 200
    directed   = .true.
    graph_type = "ER"    
    p          = 0.1
/

&dynamics
    bias_file   = "input/bias.dat"
    bias_mode   = "AUTO"
    bias_mean   = 0.0
    bias_std    = 0.1
    r_mean     = 10.0
    r_std      = 0.1
    weight_mean = 1.0
    weight_std  = 0.1
    coupling_type = "DIFFUSIVE"
/

&noise
    sigma_mean = 1.0
/

&theory
    verify_lyapunov = .true.
    n_weight_shuffles = 0
    shuffle_seed      = 1001
/

&simulation
    run_simulation = .true.
    dt       = 0.0005
    t_relax  = 0.5
    t_sample = 100.0
    lag_steps = 1
    seed     = 1
/
