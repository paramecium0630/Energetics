&network
    ! N, directed : not for FCNN
    N          = 1000
    directed   = .false.
    graph_type = "EXTERNAL"    
    p          = 0.2
/

&dynamics
    r_mean     = 86.0
    r_std      = 0.1
    weight_mean = 1.0
    weight_std  = 0.1
/

&noise
    sigma_mean = 1.0
/

&theory
    verify_lyapunov = .true.
    n_weight_shuffles = 10
    shuffle_seed      = 1001
/

&simulation
    run_simulation = .false.
    dt       = 0.0005
    t_relax  = 100.0
    t_sample = 10000.0
    lag_steps = 1
    seed     = 1
/
